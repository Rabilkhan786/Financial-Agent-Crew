# Copy this file to .env and fill in your own keys.
# NEVER put a real key in this file — .env.example is committed, .env is not.

# --- Gemini (required) -------------------------------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- LangSmith tracing (optional; the app runs without it) -------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-analysis-crew

# --- Reddit / praw (optional; missing keys => social sentiment is skipped) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=financial-analysis-crew/0.1
