# Copy this file to .env and fill in your own keys.
# NEVER put a real key in this file — .env.example is committed, .env is not.
#
# Only GOOGLE_API_KEY is required. Every other key switches on an extra
# capability; the app runs fine without all of them.

# --- Which model to use: gemini, groq or ollama ------------------------------
LLM_PROVIDER=gemini

# --- Gemini (needed when LLM_PROVIDER=gemini) --------------------------------
# Free tier is only 20 requests/day per model.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Groq (needed when LLM_PROVIDER=groq) ------------------------------------
# Free key: https://console.groq.com/keys - a much larger free allowance
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (needed when LLM_PROVIDER=ollama) --------------------------------
# Runs on this machine. No key, no limit, but slow without a discrete GPU.
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# --- LangSmith tracing (optional; the app runs without it) -------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=financial-analysis-crew

# --- Finnhub (optional; richer news than Yahoo headlines) -------------------
# Free key, issued instantly: https://finnhub.io/register
FINNHUB_API_KEY=

# --- Alpha Vantage (optional; scored news sentiment) ------------------------
# Free key, issued instantly: https://www.alphavantage.co/support/#api-key
# Free tier is roughly 25 requests/day, which is why the disk cache matters.
ALPHAVANTAGE_API_KEY=

# --- Reddit / praw (optional; without it, keyless StockTwits is used) -------
# reddit.com/prefs/apps -> create an app -> type "script" (no approval needed)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=financial-analysis-crew/0.1

# --- Tunables (optional; defaults live in src/config.py) --------------------
# RISK_FREE_RATE=0.04
# MAX_REVISIONS=2
# RECURSION_LIMIT=25
