# Copy this file to .env and fill in your own keys.
# NEVER put a real key in this file — .env.example is committed, .env is not.
#
# Only GROQ_API_KEY is required. Every other key switches on an extra
# capability; the app runs fine without all of them.

# --- Groq (required) ---------------------------------------------------------
# Free key: https://console.groq.com/keys
# Which models a key can reach varies by account, so list them rather than
# assuming a name works:
#   curl -H "Authorization: Bearer $GROQ_API_KEY" -H "User-Agent: crew" \
#        https://api.groq.com/openai/v1/models
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b


# --- Finnhub (optional; richer news than Yahoo headlines) -------------------
# Free key, issued instantly: https://finnhub.io/register
FINNHUB_API_KEY=

# --- Alpha Vantage (optional; scored news sentiment) ------------------------
# Free key, issued instantly: https://www.alphavantage.co/support/#api-key
# Free tier is roughly 25 requests/day, which is why the disk cache matters.
ALPHAVANTAGE_API_KEY=

# --- Tunables (optional; defaults live in src/config.py) --------------------
# RISK_FREE_RATE=0.04
# MAX_REVISIONS=2
# RECURSION_LIMIT=25
#
# The free tier limits both tokens per minute and tokens per day. These three
# pace and bound each model call; the defaults were reached by hitting the
# limits, not guessed.
# CALLS_PER_SECOND=0.12
# REQUEST_TIMEOUT=180
# MAX_OUTPUT_TOKENS=4096
