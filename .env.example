# Copy this file to ".env" and fill in your own keys. Never commit ".env".
# All four keys below are required for a full run. LangSmith is optional.

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Financial Modeling Prep (fundamentals) — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Alpha Vantage (price history) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Tavily (news search) — https://app.tavily.com/
TAVILY_API_KEY=

# --- Optional -------------------------------------------------------------
# LangSmith tracing. Leave blank to disable — a missing key never breaks a run.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investpanel

# Override the default model or provider if you want (optional).
# LLM_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
