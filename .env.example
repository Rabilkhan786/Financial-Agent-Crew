# Copy this file to ".env" and put your keys there. NEVER put real keys in this
# file (.env.example is committed to git). Real keys go in ".env" only.

# --- Which LLM provider to use -------------------------------------------------
# Change this one line to switch the whole panel between providers.
# Options: gemini | openai | anthropic | groq | deepseek
LLM_PROVIDER=gemini

# --- LLM provider keys: you only need the ONE you selected above ---------------
# Google Gemini — https://aistudio.google.com/app/apikey  (keys start with "AIza")
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# OpenAI / ChatGPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude — https://console.anthropic.com/
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Groq (fast, has a free tier) — https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek (cheap, strong reasoning; OpenAI-compatible) — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat   # or deepseek-reasoner for the strongest reasoning

# OpenRouter (gateway to many models; has FREE variants) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-r1:free

# --- Data providers: all three required for a full run ------------------------
# Financial Modeling Prep (fundamentals) — https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Alpha Vantage (price history) — https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Tavily (news search) — https://app.tavily.com/
TAVILY_API_KEY=

# --- Optional ----------------------------------------------------------------
# LangSmith tracing. Leave blank to disable — a missing key never breaks a run.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=investpanel
